# Repository-level supply-chain guard.
# Blocks dependency lifecycle hooks during install:
# preinstall, install, postinstall, prepack, prepare, etc.
ignore-scripts=true

# Keep dependency updates explicit and reproducible.
package-lock=true
save-exact=true

# Keep install output quieter without weakening security.
audit=true
fund=false

# Minimum package age before install — supply chain protection.
# Requires npm >= 11.10.0. Unit: days. (pnpm equivalent: minimumReleaseAge in minutes)
min-release-age=7
