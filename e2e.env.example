# Copy this file to .env.e2e.local. That local file is ignored by Git.
# Never commit real accounts or passwords.
# Leave E2E_BASE_URL unset to let Playwright start Vite automatically.
# E2E_BASE_URL=https://your-staging-environment.example

E2E_ADMIN_EMAIL=admin@example.test
E2E_ADMIN_PASSWORD=replace-with-local-password

E2E_USER_EMAIL=user@example.test
E2E_USER_PASSWORD=replace-with-local-password

E2E_DEMO_EMAIL=demo@example.test
E2E_DEMO_PASSWORD=replace-with-local-password
